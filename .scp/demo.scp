fun greet(name: string, greeting = "Hello") {
    return "${greeting}, ${name}!"
}

fun twice(n: number) {
    return n * 2
}

global visits = 0
let players = ["Steve", "Alex"]

for name in players {
    visits += 1
    if visits >= 2 {
        print(greet(name))
    } else {
        print(greet(name, "Yo"))
    }
}

print("twice 21 is ${twice(21)}")
